# ==============================================================================
# BrewLite — Environment Variables Template
# ==============================================================================

# Backend Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Lưu ý: Khi chạy qua Docker Compose, HOST đổi thành 'postgres'
DATABASE_URL="postgresql://brewlite:brewlite_secret@localhost:5432/brewlite_db?schema=public"

# Authentication (JWT)
JWT_SECRET=brewlite_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Seeding Flag (true = tự động chạy seed khi deploy Docker lần đầu)
SEED=true
