{
  "name": "brewlite-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BrewLite — Cashless Coffee Ordering System Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "test:backend": "npm run test --workspace=apps/backend",
    "test:e2e": "npm run test:e2e --workspace=apps/backend",
    "generate:diagrams": "node scripts/generate-diagrams.js",
    "docker:up": "docker compose up -d",
    "docker:deploy": "npm run build && docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "brewlite",
    "coffee",
    "nestjs",
    "nextjs",
    "prisma",
    "scrum"
  ],
  "author": "BrewLite Team",
  "license": "MIT"
}
